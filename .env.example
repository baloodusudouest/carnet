# Variables de la stack (Portainer > Stacks > Environment variables, ou fichier .env)
# Ne jamais versionner les vraies valeurs.

PORT_CARNET=8096

# Dossier des fichiers déposés à la main (créé dans File Station, pour qu'il t'appartienne :
# le conteneur adopte son propriétaire)
CARNET_DATA_DIR=/volume1/homes/<utilisateur>/carnet
# Base, sauvegardes d'iCloud et ancienne base 1.3 : hors de tout partage réseau et de OneDrive
CARNET_STATE_DIR=/volume1/docker/carnet/state

# Mot de passe de l'interface
CARNET_PASSWORD=change-moi
# Clé de la base de la 1.3 (SQLCipher) : carnet 2 la lit une seule fois, au premier démarrage,
# pour reprendre liaisons, refus, photos choisies et affiches. À retirer après la bascule.
CARNET_DB_KEY=change-moi

# Heure de la nuit (lecture d'iCloud, écritures sûres, copies). « off » : nuit désactivée
CARNET_VEILLE_HEURE=03:00

# Facultatif : un contact contenant l'émoji rejoint automatiquement le groupe (règles séparées par ;)
# CARNET_EMOJI_GROUPES=🍕:Amis;🔧:Artisans et services

# iCloud : identifiant Apple et mot de passe d'application
# (account.apple.com > Connexion et sécurité > Mots de passe pour app), jamais celui du compte
CARNET_ICLOUD_USER=
CARNET_ICLOUD_PASSWORD=

# Copie de nuit dans Synology Contacts (compte DSM « carnet », application Contacts autorisée)
CARNET_SYNOLOGY_URL=http://<adresse du NAS>:5000/carddav/carnet/
CARNET_SYNOLOGY_PASSWORD=

# LinkedIn (facultatif) : app LinkedIn Developers avec le produit « Member Data Portability API (Member) »,
# adresse de retour https://localhost/carnet-linkedin déclarée dans son onglet Auth
CARNET_LINKEDIN_CLIENT_ID=
CARNET_LINKEDIN_CLIENT_SECRET=

# Déjà présentes pour le kit d'urgence (mêmes valeurs)
KIT_DATA_DIR=/volume1/homes/<utilisateur>/kit-urgence
KIT_API_TOKEN=change-moi
