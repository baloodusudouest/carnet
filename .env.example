# Variables de la stack (Portainer > Stacks > Environment variables, ou fichier .env)
# Ne jamais versionner les vraies valeurs.

PORT_CARNET=8096

# Dossier des fichiers déposés à la main (créé dans File Station, pour qu'il t'appartienne :
# le conteneur adopte son propriétaire)
CARNET_DATA_DIR=/volume1/homes/<utilisateur>/carnet
# Base et sauvegardes d'iCloud : hors de tout partage réseau et de OneDrive
CARNET_STATE_DIR=/volume1/docker/carnet/state

# Mot de passe commun des applis de la maison (12 caractères au moins, sinon carnet ne démarre pas)
MAISON_PASSWORD=change-moi
# Jeton commun des échanges entre applis maison (Sillage, Gazette, Douze points, Millésime, kit, Anneau)
# MAISON_JETON=un-long-jeton-commun
# MAISON_LECTURE_SEULE=oui
# Mode lecture seule : « oui » pour essayer une version sans risque. carnet lit et calcule,
# mais n'écrit ni dans iCloud, ni dans Immich, Treemich, Synology Contacts ou le kit d'urgence.
# CARNET_LECTURE_SEULE=oui

# 2.26 : l'heure de la nuit, les émojis → groupes, le carnet d'adresses Synology et la vérification de son
# certificat se règlent dans l'écran Réglages de carnet (plus dans la stack).

# iCloud : identifiant Apple et mot de passe d'application
# (account.apple.com > Connexion et sécurité > Mots de passe pour app), jamais celui du compte
CARNET_ICLOUD_USER=
CARNET_ICLOUD_PASSWORD=

# Copie de nuit dans Synology Contacts (compte DSM « carnet », application Contacts autorisée)
CARNET_SYNOLOGY_URL=http://<adresse du NAS>:5000/carddav/carnet/
CARNET_SYNOLOGY_PASSWORD=

# LinkedIn (facultatif) : app LinkedIn Developers avec le produit « Member Data Portability API (Member) »,
# adresse de retour https://localhost/carnet-linkedin déclarée dans son onglet Auth
CARNET_LINKEDIN_CLIENT_ID=
CARNET_LINKEDIN_CLIENT_SECRET=

# Telegram (facultatif) : my.telegram.org > API development tools. Sert seulement à l'import ponctuel
# des contacts depuis État > Réseaux ; la session Telegram n'est jamais gardée.
CARNET_TELEGRAM_API_ID=
CARNET_TELEGRAM_API_HASH=

# Déjà présente pour le kit d'urgence (même valeur)
KIT_DATA_DIR=/volume1/homes/<utilisateur>/kit-urgence
